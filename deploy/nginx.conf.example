# Copy this to /etc/nginx/sites-available/savartourlover on the droplet,
# then: ln -s /etc/nginx/sites-available/savartourlover /etc/nginx/sites-enabled/
# Replace yourdomain.com below, then run: certbot --nginx -d yourdomain.com
# certbot will rewrite this file to add the TLS server block automatically.

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # Next.js already compresses; keep client body size reasonable for
    # image/document uploads if the app accepts any.
    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
