# ==============================================================================
# ATITHI TRAVEL PLATFORM - ENVIRONMENT EXAMPLE (.env.example)
# Copy to .env.local for local development. Set these in Vercel Project Settings for production.
# ==============================================================================

# Site URLs
NEXT_PUBLIC_SITE_URL=https://savartourlover.com
SITE_URL=https://savartourlover.com
NEXT_PUBLIC_API_URL=/api/v1

# Security & Session Secrets (generate random strings with openssl rand -base64 48)
JWT_SECRET=
CLEARANCE_SECRET=
CRON_SECRET=

# Supabase (Vercel-Integrated or Standalone)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tourlover-data
SUPABASE_WEBHOOK_SECRET=

# bKash Payment Gateway
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_SANDBOX=true

# Dutch-Bangla Bank Rocket Payment Gateway & Merchant QR
ROCKET_MERCHANT_ID=
ROCKET_MERCHANT_NAME=
ROCKET_MERCHANT_TID=
ROCKET_ACCOUNT_NUMBER=
ROCKET_SMS_SECRET=
ROCKET_APP_KEY=
ROCKET_APP_SECRET=
ROCKET_BASE_URL=https://rocket.dutchbanglabank.com:8443/epay
ROCKET_SANDBOX=false
