# ---- Copy to .env.local (never commit real values) ---------------------------------------------

# Leave empty / relative to use the built-in Next.js API routes.
NEXT_PUBLIC_API_URL=/api/v1

# REQUIRED in production. Generate each with:  openssl rand -base64 48
JWT_SECRET=
CLEARANCE_SECRET=

# Supabase. The SECRET key is server-only: create a new one in Dashboard -> Project Settings -> API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared secret required by /api/v1/supabase/webhook (send it as header x-webhook-secret)
SUPABASE_WEBHOOK_SECRET=

# bKash Payment Gateway. Set BKASH_SANDBOX=false with live merchant credentials.
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_SANDBOX=true

# SSLCommerz. Set SSLCOMMERZ_SANDBOX=false only with live credentials.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Passwords for the staff accounts created the FIRST time the database is seeded.
# In production, if these are unset a random password is generated and printed once in the server log.
SEED_ADMIN_PASSWORD=
SEED_FINANCE_PASSWORD=
SEED_HOST_PASSWORD=

# Set to "true" ONLY on a staging/demo deployment to expose the fake payment simulator in production.
# ALLOW_PAYMENT_SIMULATOR=false

# ---- Scaling on Vercel Hobby + Supabase Free (see README) ---------------------------------------

# Secures /api/cron/keepalive (the daily Supabase keep-alive ping — see vercel.json) so it can't be
# triggered by anyone who finds the URL. Vercel sends this automatically on its own cron invocations.
# Generate with: openssl rand -base64 24
CRON_SECRET=

# How often (ms) a warm serverless instance may re-pull the full catalog from Supabase in the
# background. Public pages are cached via ISR (see `revalidate` in src/app/**/page.tsx) so this
# mostly bounds worst-case egress from instances that are actually running. Default: 45000 (45s).
# SUPABASE_SYNC_INTERVAL_MS=45000

# How often (ms) a full-database backup snapshot is uploaded to Supabase Storage. Every write
# (booking, payment, profile edit...) already durably persists its own row straight to Postgres;
# this is a belt-and-braces full backup, throttled so it doesn't re-upload the entire database on
# every single write. Default: 300000 (5 min).
# SUPABASE_SNAPSHOT_BACKUP_INTERVAL_MS=300000

# Optional: makes rate limiting (login attempts, booking creation, payment initiation, contact
# form) exact across every serverless instance instead of a soft per-instance guard. Free tier at
# Upstash (https://upstash.com) is plenty for this — create a Redis database there, then copy its
# REST URL/token here. Rate limiting still works without this, just less precisely under real
# concurrent load across many instances (see src/server/rateLimit.ts).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
